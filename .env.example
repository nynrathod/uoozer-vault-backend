# ── Environment ───────────────────────────────────────────────
ENVIRONMENT=development
RUST_LOG=uoozer_vault_backend=debug,tower_http=debug,sqlx=warn

# ── Server ────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ── Database (Neon or local Postgres) ─────────────────────────
DATABASE_URL=postgres://postgres:admin@localhost:5432/uoozer_vault

# ── JWT signing (Ed25519 PEM private key) ────────────────────
# Generate with:
#   openssl genpkey -algorithm Ed25519 -out ed25519-priv.pem
#   openssl pkey -in ed25519-priv.pem -pubout -out ed25519-pub.pem
JWT_PRIVATE_KEY_PEM=|
-----BEGIN PRIVATE KEY-----
MC4CAQAwBQYDK2VwBCIEIH+your+ed25519+private+key+here==
-----END PRIVATE KEY-----
JWT_ISSUER=uoozer-vault
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# ── Argon2id params (returned to client, enforced server-side) ─
ARGON2_M_COST=65536
ARGON2_T_COST=3
ARGON2_P_COST=4
ARGON2_OUTPUT_LEN=32

# ── Bcrypt cost for Auth Key hash ─────────────────────────────
BCRYPT_COST=12

# ── Anti-enumeration pepper (random 32-byte hex, never shared) ─
PRELOGIN_PEPPER=change_me_to_a_random_32_byte_hex_string

# ── CORS ──────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Cloudflare R2 ─────────────────────────────────────────────
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET=uoozer-vault
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_PRESIGN_TTL_SECONDS=300

# ── Rate limiting ─────────────────────────────────────────────
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=120
