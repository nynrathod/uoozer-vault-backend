meta {
  name: Signup Init
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/signup/init
  body: json
  auth: none
}

body:json {
  {
    "email": "alice@example.com"
  }
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
    expect(res.body.signup_token).to.be.a('string');
    expect(res.body.salt).to.be.a('string');
    expect(res.body.argon2_params).to.be.an('object');
  });
}
